<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright Automation Suite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.neel.playwright.listeners.AllureTestListener"/>
        <listener class-name="com.neel.playwright.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Playwright Tests">

        <classes>

            <class name="com.neel.playwright.tests.LoginTest"/>
            <class name="com.neel.playwright.tests.LogoutTest"/>
            <class name="com.neel.playwright.tests.SelfHealingTest"/>
            <class name="com.neel.playwright.tests.CreateBuzzPostTest"/>
            <class name="com.neel.playwright.tests.DeleteBuzzPostTest"/>
            <class name="com.neel.playwright.tests.PIMEmployeeTest"/>

        </classes>

    </test>

</suite>